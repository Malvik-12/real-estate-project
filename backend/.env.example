# ===============================================
# Backend Environment Configuration Example
# Copy this to .env and fill in real credentials
# ===============================================

# Database Connection (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=real_estate

# Server Port
PORT=5001

# Security & Authentication
# Generate a strong 64-byte random string for JWT_SECRET in production
JWT_SECRET=your_super_secret_jwt_key_here
# Bcrypt hash for admin password
ADMIN_PASSWORD_HASH=$2b$12$UIUksvGNYDX9DyvM6ciZmOp3IFnNn03vDa8YJo16ZisXRjGRSCTtK

# Allowed Frontend URL for CORS
FRONTEND_URL=https://your-frontend-domain.com

# Email Notifications (SMTP / Gmail)
# For Gmail: Use your Gmail address and generate a 16-character App Password (from Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
ADMIN_EMAIL=admin_recipient@domain.com
EMAIL_FROM="Bahumukhi Real Estate <noreply@bahumukhi.com>"
